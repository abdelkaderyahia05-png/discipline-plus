<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lavande"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/chat" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/accueil_titre"
            android:textColor="@color/violet_profond"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/accueil_intro"
            android:textColor="@color/texte"
            android:textSize="15sp" />

        <!-- 1 · Accessibilité -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/carte"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm1_titre"
                android:textColor="@color/violet"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/perm1_texte"
                android:textColor="@color/texte"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/etat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/violet_profond"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ouvrirAccessibilite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bouton_violet"
                android:stateListAnimator="@null"
                android:text="@string/perm1_bouton"
                android:textAllCaps="false"
                android:textColor="@color/blanc"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm1_aide"
                android:textColor="@color/texte"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Paramètre restreint (Android 13+) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/carte"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restreint_titre"
                android:textColor="@color/violet"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/restreint_texte"
                android:textColor="@color/texte"
                android:textSize="14sp" />

            <Button
                android:id="@+id/ouvrirFiche"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="@string/restreint_bouton"
                android:textAllCaps="false"
                android:textColor="@color/violet"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2 · Internet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/carte"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm2_titre"
                android:textColor="@color/violet"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/perm2_texte"
                android:textColor="@color/texte"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/continuer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bouton_violet"
            android:stateListAnimator="@null"
            android:text="@string/accueil_continuer"
            android:textAllCaps="false"
            android:textColor="@color/blanc"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/plusTard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="@string/accueil_plus_tard"
            android:textAllCaps="false"
            android:textColor="@color/texte"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
